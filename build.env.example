# 复制为 build.env 后按本机情况填写。build.env 已被 .gitignore 排除，不会提交。
# 也可以直接用同名环境变量，效果一样。

JAVA_HOME=/path/to/jdk-21
ANDROID_HOME=/path/to/android-sdk

# 可选：Gradle 缓存目录（默认 $HOME/.gradle）
# GRADLE_USER_HOME=/path/to/gradle-home

# 可选：如果 Java 访问不了 services.gradle.org，指向本地 gradle 分发包。
# 构建时只会临时改写 gradle-wrapper.properties，构建结束自动还原。
# GRADLE_DIST_URL=file:/path/to/gradle-8.14.3-all.zip
